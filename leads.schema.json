{"$schema":"http://json-schema.org/draft-07/schema#","description":"One prospect in the Agent HQ pipeline (lives in leads.json).","properties":{"category":{"description":"e.g. Barber shop, Pho restaurant","type":"string"},"date_found":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$","type":"string"},"evidence":{"description":"One line of proof for the website_status","type":"string"},"id":{"description":"Stable id, e.g. lead-001","pattern":"^lead-[0-9]{3}$","type":"string"},"last_contact":{"description":"YYYY-MM-DD of last pitch/contact, or null","type":["string","null"]},"name":{"description":"Business name, from a real search result — never invented","type":"string"},"neighborhood":{"description":"e.g. Mount Pleasant, Hastings-Sunrise","type":"string"},"notes":{"type":"string"},"score":{"description":"Pitch opportunity, 1–5","maximum":5,"minimum":1,"type":"integer"},"status":{"description":"Pipeline stage","enum":["new","researched","pitched","negotiating","won","lost"],"type":"string"},"website":{"description":"URL string or null when there is none","type":["string","null"]},"website_status":{"enum":["none","broken","outdated","ok","unverified"],"type":"string"}},"required":["id","name","category","neighborhood","website_status","score","date_found","status"],"title":"Agent HQ lead","type":"object"}